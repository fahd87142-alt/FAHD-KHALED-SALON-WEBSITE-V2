// ==========================================
// SERVICE TOTAL
// ==========================================

function getSelectedServices() {
  const selected = [];

  document.querySelectorAll(
    "#serviceChoices input[type=checkbox]:checked"
  ).forEach(input => {
    selected.push({
      name: input.value,
      price: Number(input.dataset.price)
    });
  });

  return selected;
}

function calculateTotal() {
  const selected = getSelectedServices();

  const total = selected.reduce(
    (sum, item) => sum + item.price,
    0
  );

  $("bookingTotal").textContent = money(total);

  $("selectedServicesSummary").textContent =
    selected.length
      ? selected.map(item => item.name).join(" + ")
      : "لم يتم اختيار خدمات بعد";

  return total;
}

$("serviceChoices").addEventListener("change", calculateTotal);


// ==========================================
// APPOINTMENT TIMES
// ==========================================

function generateTimes() {
  const times = [];

  // مواعيد البداية كل 15 دقيقة
  // من 11 صباحا حتى 12:15 بعد منتصف الليل

  for (let minutes = 11 * 60; minutes <= 24 * 60 + 15; minutes += 15) {

    const normalized = minutes % (24 * 60);

    const hours = Math.floor(normalized / 60);
    const mins = normalized % 60;

    const time =
      String(hours).padStart(2, "0") +
      ":" +
      String(mins).padStart(2, "0");

    times.push(time);
  }

  return times;
}

const ALL_TIMES = generateTimes();

function getAppointmentSlots(date, time) {
  const [hours, minutes] = time.split(":").map(Number);

  const start = new Date(
    date + "T00:00:00"
  );

  start.setHours(hours, minutes, 0, 0);

  // بعد منتصف الليل يعني اليوم التالي
  if (hours < 11) {
    start.setDate(start.getDate() + 1);
  }

  const slots = [];

  for (let i = 0; i < 3; i++) {

    const current = new Date(start.getTime() + i * 15 * 60000);

    const slotDate = localDate(current);

    const slotTime =
      String(current.getHours()).padStart(2, "0") +
      ":" +
      String(current.getMinutes()).padStart(2, "0");

    slots.push({
      date: slotDate,
      time: slotTime
    });
  }

  return slots;
}


// ==========================================
// CHECK AVAILABLE BARBERS
// ==========================================

async function getBusySlots(barber, date) {

  const nextDate = addDays(date, 1);

  const q = query(
    collection(db, "barberSlots"),
    where("barber", "==", barber),
    where("date", "in", [date, nextDate])
  );

  const snapshot = await getDocs(q);

  return new Set(snapshot.docs.map(item => item.id));
}

async function isBarberAvailable(barber, date, time) {

  const slots = getAppointmentSlots(date, time);

  const busy = await getBusySlots(barber, date);

  return slots.every(slot => {
    const id = makeSlotId(
      barber,
      slot.date,
      slot.time
    );

    return !busy.has(id);
  });
}

async function refreshAvailableTimes() {

  if (!barberSelect.value || !bookingDate.value) {
    bookingTime.innerHTML =
      '<option value="">اختار الحلاق والتاريخ أولاً</option>';

    bookingTime.disabled = true;
    return;
  }

  bookingTime.disabled = true;

  bookingTime.innerHTML =
    '<option value="">جاري تحميل المواعيد...</option>';

  showMessage(
    $("availabilityMessage"),
    "جاري البحث عن المواعيد المتاحة..."
  );

  try {

    const date = bookingDate.value;
    const barber = barberSelect.value;

    const busy = await getBusySlots(barber, date);

    const available = ALL_TIMES.filter(time => {

      const slots = getAppointmentSlots(date, time);

      return slots.every(slot => {
        const id = makeSlotId(
          barber,
          slot.date,
          slot.time
        );

        return !busy.has(id);
      });
    });

    bookingTime.innerHTML =
      '<option value="">اختار الموعد المناسب</option>';

    available.forEach(time => {

      const option = document.createElement("option");

      option.value = time;
      option.textContent = time;

      bookingTime.appendChild(option);
    });

    bookingTime.disabled = false;

    if (available.length) {

      showMessage(
        $("availabilityMessage"),
        `متاح ${available.length} موعد للحلاق ${barber}`,
        "success"
      );

    } else {

      showMessage(
        $("availabilityMessage"),
        "الحلاق مشغول في اليوم ده. جرب تاريخ تاني.",
        "error"
      );
    }

  } catch (error) {

    showMessage(
      $("availabilityMessage"),
      "تعذر تحميل المواعيد. راجع اتصال الموقع.",
      "error"
    );

    console.error(error);
  }
}

barberSelect.addEventListener("change", refreshAvailableTimes);
bookingDate.addEventListener("change", refreshAvailableTimes);


// ==========================================
// FIND OTHER AVAILABLE BARBERS
// ==========================================

async function findOtherBarbers(date, time, selectedBarber) {

  const available = [];

  for (const barber of BARBERS) {

    if (barber === selectedBarber) continue;

    if (await isBarberAvailable(barber, date, time)) {
      available.push(barber);
    }
  }

  return available;
}


// ==========================================
// CREATE BOOKING SAFELY
// ==========================================

async function createBooking(data) {

  const bookingRef = doc(collection(db, "bookings"));

  const slots = getAppointmentSlots(
    data.date,
    data.time
  );

  const slotRefs = slots.map(slot => {

    const id = makeSlotId(
      data.barber,
      slot.date,
      slot.time
    );

    return {
      id,
      ref: doc(db, "barberSlots", id),
      date: slot.date,
      time: slot.time
    };
  });

  await runTransaction(db, async transaction => {

    // قراءة كل الخانات أولا
    const existing = [];

    for (const item of slotRefs) {
      existing.push(
        await transaction.get(item.ref)
      );
    }

    if (existing.some(snapshot => snapshot.exists())) {
      throw new Error(
        "الموعد اتحجز بالفعل. اختار موعد تاني."
      );
    }

    const bookingData = {
      name: data.name,
      phone: data.phone,
      barber: data.barber,
      service: data.services.map(item => item.name).join(" + "),
      services: data.services,
      total: data.total,
      date: data.date,
      time: data.time,
      notes: data.notes,
      status: "confirmed",
      slotIds: slotRefs.map(item => item.id),
      createdAt: serverTimestamp()
    };

    transaction.set(bookingRef, bookingData);

    // حجز خانات الحلاق
    slotRefs.forEach(item => {

      transaction.set(item.ref, {
        bookingId: bookingRef.id,
        barber: data.barber,
        date: item.date,
        time: item.time
      });

    });

  });

  return bookingRef.id;
}


// ==========================================
// BOOKING FORM
// ==========================================

$("bookingForm").addEventListener("submit", async event => {

  event.preventDefault();

  const button = $("submitBooking");

  const name = $("customerName").value.trim();
  const phone = normalizePhone($("customerPhone").value);
  const barber = barberSelect.value;
  const date = bookingDate.value;
  const time = bookingTime.value;
  const notes = $("bookingNotes").value.trim();

  const services = getSelectedServices();
  const total = calculateTotal();

  const message = $("formMessage");

  $("bookingConfirmation").hidden = true;

  if (name.length < 2) {
    showMessage(message, "اكتب اسمك بشكل صحيح.", "error");
    return;
  }

  if (phone.length < 7 || phone.length > 20) {
    showMessage(message, "رقم الموبايل غير صحيح.", "error");
    return;
  }

  if (!barber) {
    showMessage(message, "اختار الحلاق الأول.", "error");
    return;
  }

  if (!services.length) {
    showMessage(message, "اختار خدمة واحدة على الأقل.", "error");
    return;
  }

  if (!date || !time) {
    showMessage(message, "اختار التاريخ والموعد.", "error");
    return;
  }

  if (date < today) {
    showMessage(message, "مينفعش تحجز في تاريخ فات.", "error");
    return;
  }

  button.disabled = true;
  button.textContent = "جاري تأكيد الحجز...";

  showMessage(message, "جاري مراجعة الموعد...");

  try {

    const available = await isBarberAvailable(
      barber,
      date,
      time
    );

    if (!available) {

      const otherBarbers = await findOtherBarbers(
        date,
        time,
        barber
      );

      let text = "الموعد ده اتحجز بالفعل.";

      if (otherBarbers.length) {
        text += " متاح في نفس الوقت عند: " +
          otherBarbers.join("، ");
      } else {
        text += " اختار موعد تاني.";
      }

      throw new Error(text);
    }

    await createBooking({
      name,
      phone,
      barber,
      date,
      time,
      notes,
      services,
      total
    });

    showMessage(
      message,
      "تم تأكيد الحجز بنجاح!",
      "success"
    );

    $("confirmationDetails").textContent =
      `الاسم: ${name} | الحلاق: ${barber} | الخدمات: ${
        services.map(item => item.name).join("، ")
      } | الموعد: ${date} - ${time} | الإجمالي: ${money(total)}`;

    $("bookingConfirmation").hidden = false;

    $("bookingForm").reset();

    $("bookingDate").value = today;

    calculateTotal();

    bookingTime.innerHTML =
      '<option value="">اختار الحلاق والتاريخ أولاً</option>';

    bookingTime.disabled = true;

    $("bookingConfirmation").scrollIntoView({
      behavior: "smooth",
      block: "center"
    });

  } catch (error) {

    showMessage(
      message,
      error.message || "حصل خطأ أثناء الحجز.",
      "error"
    );

  } finally {

    button.disabled = false;
    button.textContent = "تأكيد الحجز";
  }

});


// ==========================================
// LOYALTY SYSTEM
// ==========================================

async function sha256(value) {

  const encoded = new TextEncoder().encode(value);

  const hash = await crypto.subtle.digest(
    "SHA-256",
    encoded
  );

  return Array.from(new Uint8Array(hash))
    .map(byte => byte.toString(16).padStart(2, "0"))
    .join("");
}

$("loyaltyForm").addEventListener("submit", async event => {

  event.preventDefault();

  const phone = normalizePhone(
    $("loyaltyPhone").value
  );

  if (phone.length < 7) {
    showMessage(
      $("loyaltyMessage"),
      "اكتب رقم موبايل صحيح.",
      "error"
    );
    return;
  }

  const button = $("loyaltySearchButton");

  button.disabled = true;
  button.textContent = "جاري البحث...";

  try {

    const customerId = await sha256(phone);

    const customerRef = doc(
      db,
      "customers",
      customerId
    );

    const snapshot = await getDoc(customerRef);

    if (!snapshot.exists()) {

      $("loyaltyResult").hidden = true;

      showMessage(
        $("loyaltyMessage"),
        "لسه مفيش زيارات مكتملة مسجلة بالرقم ده."
      );

      return;
    }

    const customer = snapshot.data();

    const visits = Number(customer.visits || 0);
    const rewards = Number(customer.rewards || 0);

    $("loyaltyVisits").textContent = visits;
    $("loyaltyRewards").textContent = rewards;

    const remaining = 5 - (visits % 5);

    $("loyaltyNextReward").textContent =
      remaining === 5
        ? "أنت تستحق مكافأة جديدة!"
        : `فاضلك ${remaining} زيارة للمكافأة القادمة.`;

    $("loyaltyResult").hidden = false;

    showMessage(
      $("loyaltyMessage"),
      "تم العثور على حسابك.",
      "success"
    );

  } catch (error) {

    showMessage(
      $("loyaltyMessage"),
      "تعذر الاستعلام. حاول مرة تانية.",
      "error"
    );

    console.error(error);

  } finally {

    button.disabled = false;
    button.textContent = "استعلام عن نقاطي";
  }

});


