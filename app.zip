// ========================================
// ADMIN LOGIN
// ========================================

$("adminLoginForm")?.addEventListener("submit", async event => {
  event.preventDefault();

  const email = $("adminEmail").value.trim();
  const password = $("adminPassword").value;

  const button = $("adminLoginButton");

  button.disabled = true;
  button.textContent = "جاري تسجيل الدخول...";

  message("adminLoginMessage", "");

  try {
    const result = await signInWithEmailAndPassword(
      auth,
      email,
      password
    );

    if (result.user.uid !== ADMIN_UID) {
      await signOut(auth);
      throw new Error("هذا الحساب ليس حساب الإدارة.");
    }

  } catch (error) {
    console.error("Login error:", error);

    message(
      "adminLoginMessage",
      "فشل تسجيل الدخول: " + error.message,
      "#ff7777"
    );

  } finally {
    button.disabled = false;
    button.textContent = "تسجيل الدخول";
  }
});

// ========================================
// ADMIN AUTH STATE
// ========================================

onAuthStateChanged(auth, async user => {

  if (user && user.uid === ADMIN_UID) {

    $("adminLoginForm").hidden = true;
    $("adminDashboard").hidden = false;

    message("adminStatus", "تم تسجيل دخول الإدارة بنجاح.");

    await loadAdminBookings();

  } else {

    $("adminLoginForm").hidden = false;
    $("adminDashboard").hidden = true;

    if (user) {
      await signOut(auth);
    }
  }
});

// ========================================
// LOAD ADMIN BOOKINGS
// ========================================

async function loadAdminBookings() {

  if (auth.currentUser?.uid !== ADMIN_UID) return;

  const list = $("bookingsList");
  list.innerHTML = "جاري تحميل الحجوزات...";

  try {

    const q = query(
      collection(db, "bookings"),
      orderBy("createdAt", "desc"),
      limit(100)
    );

    const snapshot = await getDocs(q);

    list.innerHTML = "";

    if (snapshot.empty) {
      list.textContent = "لا توجد حجوزات حتى الآن.";
      return;
    }

    snapshot.forEach(bookingDoc => {

      const booking = bookingDoc.data();

      const card = document.createElement("div");
      card.className = "booking-card";

      const details = document.createElement("p");

      details.textContent =
        `الاسم: ${booking.name} | الهاتف: ${booking.phone} | الحلاق: ${booking.barber} | التاريخ: ${booking.date} | الموعد: ${booking.time} | الخدمات: ${booking.service} | الإجمالي: ${booking.total} جنيه | الحالة: ${booking.status}`;

      const statusSelect = document.createElement("select");

      [
        ["new", "جديد"],
        ["confirmed", "مؤكد"],
        ["completed", "مكتمل"],
        ["rejected", "مرفوض"]
      ].forEach(([value, label]) => {
        statusSelect.add(new Option(label, value));
      });

      statusSelect.value = booking.status || "confirmed";

      const saveButton = document.createElement("button");
      saveButton.textContent = "حفظ الحالة";
      saveButton.type = "button";

      saveButton.addEventListener("click", async () => {
        try {
          if (auth.currentUser?.uid !== ADMIN_UID) return;

          saveButton.disabled = true;

          await updateDoc(
            doc(db, "bookings", bookingDoc.id),
            { status: statusSelect.value }
          );

          message("adminStatus", "تم تحديث حالة الحجز.");

          await loadAdminBookings();

        } catch (error) {
          message(
            "adminStatus",
            "تعذر تحديث الحجز: " + error.message,
            "#ff7777"
          );

          saveButton.disabled = false;
        }
      });

      const deleteButton = document.createElement("button");
      deleteButton.textContent = "حذف الحجز";
      deleteButton.type = "button";

      deleteButton.addEventListener("click", async () => {

        if (!confirm("هل أنت متأكد من حذف الحجز؟")) return;

        try {

          if (auth.currentUser?.uid !== ADMIN_UID) return;

          deleteButton.disabled = true;

          await runTransaction(db, async transaction => {

            const bookingRef = doc(db, "bookings", bookingDoc.id);
            const current = await transaction.get(bookingRef);

            if (!current.exists()) return;

            const data = current.data();

            for (const slotId of (data.slotIds || [])) {
              const slotRef = doc(db, "barberSlots", slotId);
              const slot = await transaction.get(slotRef);

              if (slot.exists() &&
                  slot.data().bookingId === bookingDoc.id) {
                transaction.delete(slotRef);
              }
            }

            transaction.delete(bookingRef);
          });

          await loadAdminBookings();

        } catch (error) {
          message(
            "adminStatus",
            "تعذر حذف الحجز: " + error.message,
            "#ff7777"
          );

          deleteButton.disabled = false;
        }
      });

      card.appendChild(details);
      card.appendChild(statusSelect);
      card.appendChild(saveButton);
      card.appendChild(deleteButton);

      list.appendChild(card);
    });

  } catch (error) {
    console.error("Admin bookings error:", error);

    list.textContent = "خطأ في تحميل الحجوزات: " + error.message;
  }
}

