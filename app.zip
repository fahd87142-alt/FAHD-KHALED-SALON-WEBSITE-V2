// ==========================================
// ADMIN LOGIN
// ==========================================

$("adminLoginForm")?.addEventListener(
  "submit",
  async event => {
    event.preventDefault();

    const button = $("adminLoginButton");

    const email = $("adminEmail").value.trim();
    const password = $("adminPassword").value;

    button.disabled = true;
    button.textContent = "جاري تسجيل الدخول...";

    showMessage(
      $("adminLoginMessage"),
      "جاري الاتصال بحساب الإدارة..."
    );

    try {
      const result = await signInWithEmailAndPassword(
        auth,
        email,
        password
      );

      if (!isAdminUser(result.user)) {
        await signOut(auth);

        throw new Error(
          "الحساب ده مش مسموح له بدخول لوحة الإدارة."
        );
      }

      showMessage(
        $("adminLoginMessage"),
        "تم تسجيل الدخول بنجاح.",
        "success"
      );

    } catch (error) {
      console.error("Admin login error:", error);

      let message = "فشل تسجيل الدخول.";

      if (
        error.code === "auth/invalid-credential" ||
        error.code === "auth/wrong-password" ||
        error.code === "auth/user-not-found"
      ) {
        message =
          "البريد الإلكتروني أو كلمة المرور غير صحيحة.";
      } else if (error.code === "auth/too-many-requests") {
        message =
          "محاولات كتير. استنى شوية وحاول تاني.";
      } else {
        message = error.message || message;
      }

      showMessage(
        $("adminLoginMessage"),
        message,
        "error"
      );

    } finally {
      button.disabled = false;
      button.textContent = "تسجيل الدخول";
    }
  }
);


// ==========================================
// ADMIN AUTH STATE
// ==========================================

onAuthStateChanged(auth, user => {
  if (isAdminUser(user)) {
    if ($("adminLogin")) {
      $("adminLogin").hidden = true;
    }

    if ($("adminDashboard")) {
      $("adminDashboard").hidden = false;
    }

    loadBookings();

  } else {
    if ($("adminLogin")) {
      $("adminLogin").hidden = false;
    }

    if ($("adminDashboard")) {
      $("adminDashboard").hidden = true;
    }

    if ($("bookingsList")) {
      $("bookingsList").innerHTML = "";
    }
  }
});


// ==========================================
// ADMIN LOAD BOOKINGS
// ==========================================

async function loadBookings() {
  const list = $("bookingsList");

  if (!list) return;

  list.innerHTML = "<p>جاري تحميل الحجوزات...</p>";

  try {
    const q = query(
      collection(db, "bookings"),
      orderBy("createdAt", "desc")
    );

    const snapshot = await getDocs(q);

    if (snapshot.empty) {
      list.innerHTML =
        "<p>مفيش حجوزات لحد دلوقتي.</p>";
      return;
    }

    list.innerHTML = "";

    snapshot.forEach(item => {
      const booking = item.data();

      const card = document.createElement("article");

      card.className = "booking-admin-card";

      const statusNames = {
        new: "جديد",
        confirmed: "مؤكد",
        rejected: "مرفوض",
        completed: "مكتمل"
      };

      card.innerHTML = `
        <h4>${escapeHTML(booking.name)}</h4>
        <p>الموبايل: ${escapeHTML(booking.phone)}</p>
        <p>الحلاق: ${escapeHTML(booking.barber)}</p>
        <p>الخدمات: ${escapeHTML(booking.service)}</p>
        <p>الإجمالي: ${money(booking.total)}</p>
        <p>التاريخ: ${escapeHTML(booking.date)}</p>
        <p>الوقت: ${escapeHTML(booking.time)}</p>
        <p>ملاحظات: ${escapeHTML(booking.notes || "لا يوجد")}</p>
        <p>الحالة: ${statusNames[booking.status] || "غير محدد"}</p>

        <div class="booking-admin-actions">
          <select class="booking-status">
            <option value="confirmed">مؤكد</option>
            <option value="new">جديد</option>
            <option value="completed">مكتمل</option>
            <option value="rejected">مرفوض</option>
          </select>

          <button type="button" class="save-status">
            حفظ الحالة
          </button>

          <button type="button" class="delete-booking danger">
            حذف الحجز
          </button>
        </div>
      `;

      const statusSelect =
        card.querySelector(".booking-status");

      statusSelect.value = booking.status || "confirmed";

      card.querySelector(".save-status").addEventListener(
        "click",
        () => updateBookingStatus(
          item.id,
          booking,
          statusSelect.value
        )
      );

      card.querySelector(".delete-booking").addEventListener(
        "click",
        () => deleteBooking(item.id, booking)
      );

      list.appendChild(card);
    });

    showMessage(
      $("adminStatus"),
      `عدد الحجوزات: ${snapshot.size}`,
      "success"
    );

  } catch (error) {
    console.error("Load bookings error:", error);

    list.innerHTML =
      "<p>تعذر تحميل الحجوزات. راجع صلاحيات Firebase.</p>";

    showMessage(
      $("adminStatus"),
      error.message,
      "error"
    );
  }
}


// ==========================================
// ADMIN UPDATE BOOKING STATUS
// ==========================================

async function updateBookingStatus(
  id,
  booking,
  newStatus
) {
  if (!isAdminUser(auth.currentUser)) return;

  try {
    const bookingRef = doc(db, "bookings", id);

    // لا نحتسب الزيارة مرتين عند إعادة الحفظ
    if (
      newStatus === "completed" &&
      booking.status !== "completed"
    ) {
      await addCompletedVisit(booking.phone, id);
    }

    await updateDoc(bookingRef, {
      status: newStatus,
      updatedAt: serverTimestamp()
    });

    showMessage(
      $("adminStatus"),
      "تم تحديث حالة الحجز.",
      "success"
    );

    await loadBookings();

  } catch (error) {
    console.error(error);

    showMessage(
      $("adminStatus"),
      error.message,
      "error"
    );
  }
}


// ==========================================
// ADD COMPLETED VISIT
// ==========================================

async function addCompletedVisit(phone, bookingId) {
  const normalized = normalizePhone(phone);

  const customerId = await sha256(normalized);

  const customerRef = doc(
    db,
    "customers",
    customerId
  );

  const visitRef = doc(
    db,
    "loyaltyVisits",
    bookingId
  );

  await runTransaction(db, async transaction => {
    const visitSnapshot = await transaction.get(visitRef);

    if (visitSnapshot.exists()) {
      return;
    }

    const customerSnapshot =
      await transaction.get(customerRef);

    let visits = 0;
    let rewards = 0;

    if (customerSnapshot.exists()) {
      visits = Number(
        customerSnapshot.data().visits || 0
      );

      rewards = Number(
        customerSnapshot.data().rewards || 0
      );
    }

    visits++;

    if (visits % 5 === 0) {
      rewards++;
    }

    transaction.set(customerRef, {
      phoneHash: customerId,
      visits,
      rewards,
      updatedAt: serverTimestamp()
    });

    transaction.set(visitRef, {
      bookingId,
      customerId,
      createdAt: serverTimestamp()
    });
  });
}


// ==========================================
// ADMIN DELETE BOOKING
// ==========================================

async function deleteBooking(id, booking) {
  if (!isAdminUser(auth.currentUser)) return;

  const confirmed = confirm(
    "هل أنت متأكد من حذف الحجز؟"
  );

  if (!confirmed) return;

  try {
    const batch = writeBatch(db);

    batch.delete(doc(db, "bookings", id));

    if (Array.isArray(booking.slotIds)) {
      booking.slotIds.forEach(slotId => {
        batch.delete(
          doc(db, "barberSlots", slotId)
        );
      });
    }

    await batch.commit();

    showMessage(
      $("adminStatus"),
      "تم حذف الحجز وإتاحة موعده من جديد.",
      "success"
    );

    await loadBookings();

  } catch (error) {
    console.error(error);

    showMessage(
      $("adminStatus"),
      error.message,
      "error"
    );
  }
}


// ==========================================
// ADMIN LOGOUT
// ==========================================

$("adminLogout")?.addEventListener(
  "click",
  async () => {
    try {
      await signOut(auth);

      if ($("adminLogin")) {
        $("adminLogin").hidden = false;
      }

      if ($("adminDashboard")) {
        $("adminDashboard").hidden = true;
      }

      showMessage(
        $("adminLoginMessage"),
        "تم تسجيل الخروج."
      );

    } catch (error) {
      showMessage(
        $("adminStatus"),
        error.message,
        "error"
      );
    }
  }
);


