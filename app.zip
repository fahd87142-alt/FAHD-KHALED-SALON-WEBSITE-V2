// FOOTER YEAR
// ========================================

if ($("currentYear")) {
  $("currentYear").textContent = new Date().getFullYear();
}

// ========================================
// SERVICES AND TOTAL
// ========================================

function calculateTotal() {
  const selected = document.querySelectorAll(
    '#serviceChoices input[type="checkbox"]:checked'
  );

  let total = 0;
  const names = [];

  selected.forEach(item => {
    total += Number(item.dataset.price || 0);
    names.push(item.value);
  });

  if ($("bookingTotal")) {
    $("bookingTotal").textContent = total;
  }

  if ($("selectedServicesSummary")) {
    $("selectedServicesSummary").textContent =
      names.length ? "الخدمات المختارة: " + names.join(" - ") : "";
  }

  return { total, names };
}

document.querySelectorAll(
  '#serviceChoices input[type="checkbox"]'
).forEach(item => {
  item.addEventListener("change", calculateTotal);
});

// ========================================
// DATE LIMIT
// ========================================

if ($("bookingDate")) {
  $("bookingDate").min = localDate(new Date());
}

// ========================================
// LOAD AVAILABLE TIMES
// ========================================

let loadingTimes = false;

async function loadAvailableTimes() {
  const barber = $("barberSelect")?.value;
  const date = $("bookingDate")?.value;
  const select = $("bookingTime");

  if (!select) return;

  select.innerHTML = "";

  if (!barber || !date) {
    select.add(new Option("اختار الحلاق والتاريخ أولاً", ""));
    select.disabled = true;
    message("availabilityMessage", "");
    return;
  }

  if (date < localDate(new Date())) {
    select.add(new Option("التاريخ غير صالح", ""));
    select.disabled = true;
    message("availabilityMessage", "اختار تاريخ اليوم أو تاريخ قادم.");
    return;
  }

  if (loadingTimes) return;

  loadingTimes = true;
  select.disabled = true;
  select.add(new Option("جاري تحميل المواعيد...", ""));

  message("availabilityMessage", "جاري فحص المواعيد...");

  try {
    const q = query(
      collection(db, "barberSlots"),
      where("barber", "==", barber)
    );

    const snapshot = await getDocs(q);

    const busy = new Set();

    snapshot.forEach(item => {
      const data = item.data();

      if (data.date) {
        busy.add(`${data.date}|${data.time}`);
      }
    });

    select.innerHTML = "";

    const now = new Date();
    const today = localDate(now);
    const currentMinutes = now.getHours() * 60 + now.getMinutes();

    let available = 0;

    for (let minutes = 660; minutes <= 1455; minutes += 15) {
      const dayOffset = Math.floor(minutes / 1440);
      const actualMinutes = minutes % 1440;

      const hour = Math.floor(actualMinutes / 60);
      const minute = actualMinutes % 60;

      const time =
        String(hour).padStart(2, "0") + ":" +
        String(minute).padStart(2, "0");

      if (date === today && dayOffset === 0 &&
          actualMinutes <= currentMinutes) {
        continue;
      }

      if (date === today && dayOffset === 1 &&
          currentMinutes >= 660) {
        // لا نمنع مواعيد اليوم التالي
      }

      const slots = getAppointmentSlots(date, time);

      const isBusy = slots.some(slot =>
        busy.has(`${slot.date}|${slot.time}`)
      );

      if (!isBusy) {
        const option = new Option(timeLabel(time), time);
        select.add(option);
        available++;
      }
    }

    if (available === 0) {
      select.add(new Option("لا توجد مواعيد متاحة", ""));
      select.disabled = true;
      message("availabilityMessage", "لا توجد مواعيد متاحة في هذا اليوم.");
    } else {
      select.disabled = false;
      message(
        "availabilityMessage",
        `متاح ${available} موعد. اختار الموعد المناسب ليك.`
      );
    }

  } catch (error) {
    console.error("Availability error:", error);

    select.innerHTML = "";
    select.add(new Option("تعذر تحميل المواعيد", ""));
    select.disabled = true;

    message(
      "availabilityMessage",
      "حصل خطأ أثناء تحميل المواعيد: " + error.message,
      "#ff7777"
    );

  } finally {
    loadingTimes = false;
  }
}

$("barberSelect")?.addEventListener("change", loadAvailableTimes);
$("bookingDate")?.addEventListener("change", loadAvailableTimes);

// ========================================
// CREATE BOOKING
// ========================================

let bookingInProgress = false;

$("bookingForm")?.addEventListener("submit", async event => {
  event.preventDefault();

  if (bookingInProgress) return;

  const name = $("customerName").value.trim();
  const phone = $("customerPhone").value.trim();
  const barber = $("barberSelect").value;
  const date = $("bookingDate").value;
  const time = $("bookingTime").value;
  const notes = $("bookingNotes").value.trim();

  const services = calculateTotal();

  if (name.length < 2) {
    message("formMessage", "اكتب اسمك بشكل صحيح.");
    return;
  }

  if (!/^01[0125][0-9]{8}$/.test(phone)) {
    message("formMessage", "اكتب رقم موبايل مصري صحيح.");
    return;
  }

  if (!barber || !date || !time) {
    message("formMessage", "اختار الحلاق والتاريخ والموعد.");
    return;
  }

  if (services.names.length === 0) {
    message("formMessage", "اختار خدمة واحدة على الأقل.");
    return;
  }

  if (date < localDate(new Date())) {
    message("formMessage", "لا يمكن الحجز في تاريخ سابق.");
    return;
  }

  bookingInProgress = true;

  const button = $("submitBooking");
  button.disabled = true;
  button.textContent = "جاري تسجيل الحجز...";

  message("formMessage", "");

  try {
    const bookingRef = doc(collection(db, "bookings"));

    const slots = getAppointmentSlots(date, time);

    await runTransaction(db, async transaction => {

      const slotRefs = slots.map(slot =>
        doc(db, "barberSlots", slot.id)
      );

      const slotSnapshots = [];

      for (const ref of slotRefs) {
        slotSnapshots.push(await transaction.get(ref));
      }

      if (slotSnapshots.some(snap => snap.exists())) {
        throw new Error("الموعد اتاخد للتو. اختار موعداً آخر.");
      }

      const bookingData = {
        name,
        phone,
        barber,
        service: services.names.join(" + "),
        services: services.names,
        total: services.total,
        date,
        time,
        notes,
        status: "confirmed",
        slotIds: slots.map(slot => slot.id),
        createdAt: serverTimestamp()
      };

      transaction.set(bookingRef, bookingData);

      slots.forEach((slot, index) => {
        transaction.set(slotRefs[index], {
          bookingId: bookingRef.id,
          barber,
          date: slot.date,
          time: slot.time
        });
      });
    });

    $("bookingConfirmation").hidden = false;

    $("confirmationDetails").textContent =
      `الاسم: ${name} | الحلاق: ${barber} | التاريخ: ${date} | الموعد: ${timeLabel(time)} | الإجمالي: ${services.total} جنيه`;

    message("formMessage", "تم تسجيل الحجز بنجاح.", "#75e49a");

    $("bookingForm").reset();
    calculateTotal();

    await loadAvailableTimes();

    $("bookingConfirmation").scrollIntoView({
      behavior: "smooth",
      block: "center"
    });

  } catch (error) {
    console.error("Booking error:", error);

    message(
      "formMessage",
      "لم يتم الحجز: " + error.message,
      "#ff7777"
    );

  } finally {
    bookingInProgress = false;
    button.disabled = false;
    button.textContent = "تأكيد الحجز";
  }
});

